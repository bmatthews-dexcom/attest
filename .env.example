# attest — local .env template
#
# Copy to `.env` and fill in. `.env` is gitignored.
# Nothing in this template is required for local use (`bdk dev`).
# Everything here is only read by `./scripts/deploy.sh --publish` or
# `npm run live-eval`.

# ─── Cursor API key ─────────────────────────────────────────────────────
# Required for:
#   • `./scripts/deploy.sh --publish`         (hosted deploy of conductor + experts)
#   • `npm run live-eval`                     (drives a real Cursor model turn)
#
# Create one at: https://cursor.com/dashboard  →  Settings  →  API Keys
# Prefer a Project-scoped key over a personal key when deploying.
# NEVER commit this value — the entire .env file is gitignored for a reason.
CURSOR_API_KEY=

# ─── Optional overrides for deploy.sh ───────────────────────────────────
# Pin a specific @cursor/bdk CLI version (default is the pinned release in
# scripts/deploy.sh — bump both at once).
# BDK_VERSION=0.2.27

# Skip the git-cleanliness guard. Set to 1 only for the dry-run flow on a
# dirty branch. `--publish` always refuses on a dirty / unpushed tree.
# SKIP_GIT_CHECK=0

# ─── Optional overrides for live-eval.mjs ───────────────────────────────
# Point at a different BDK eval case (default: integration/attest-e2e).
# LIVE_EVAL_CASE=integration/attest-e2e

# Point at a different BDK CLI invocation (default: `npx @cursor/bdk`).
# LIVE_EVAL_BDK="npx @cursor/bdk"

# Skip the attest-mcp build artifact check (if you're intentionally
# running without the local MCP build).
# LIVE_EVAL_SKIP_BUILD=1
