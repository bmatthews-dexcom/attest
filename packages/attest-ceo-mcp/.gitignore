# Build outputs are committed to git so deploys don't need a build step
# server-side (BDK runs `npm install` under --omit=dev, which strips tsc
# and never runs the prepare hook; and attest-ceo imports from this
# package's `./dist/*.js` directly, not through the MCP transport, so a
# missing dist means attest-ceo fails module-load on the hosted container).
# Keep dist/ regenerated via `npm run build` before every commit that
# touches src/*.ts.

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
*.swp
